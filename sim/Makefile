#
# Simulator Makefile (PC host compile + SDL2)
# Usage: make            # build
#        make clean
# Output: build_sim/bin/pico_nav_sim
# Run:    ./build_sim/bin/pico_nav_sim
#
CC           = gcc
LVGL_DIR     = ..
LVGL_DIR_NAME = lvgl

# keep 'all' as the default goal: the -include'd .d dep files below
# contain real rules which would otherwise hijack the first-target slot
.DEFAULT_GOAL := all

WARNINGS := -Wall -Wextra -Wno-unused-parameter -Wno-unused-function \
            -Wno-missing-field-initializers -Wno-sign-compare -Wno-cast-qual

CFLAGS  := -O2 -g -I$(LVGL_DIR)/ -I$(LVGL_DIR)/$(LVGL_DIR_NAME)/ -I. $(shell sdl2-config --cflags) \
           -DLV_CONF_INCLUDE_SIMPLE $(WARNINGS) -std=c99 -MMD -MP
LDFLAGS := -lm $(shell sdl2-config --libs)

BIN        = pico_nav_sim
BUILD_DIR  = ./build_sim
OBJ_DIR    = $(BUILD_DIR)/obj
BIN_DIR    = $(BUILD_DIR)/bin

# Simulator sources: app framework + sim HAL + SDL entry
MAINSRC = main_sim.c \
          hal_keys_sdl.c \
          $(wildcard ../App/*.c) \
          $(wildcard ../App/Utils/*.c) \
          $(wildcard ../App/Pages/*.c) \
          $(wildcard ../Mapsforge/*.c) \
          $(wildcard ../third_party/cJSON/*.c)

include $(LVGL_DIR)/lvgl/lvgl.mk

OBJEXT = .o
COBJS = $(CSRCS:.c=$(OBJEXT))
MAINOBJ = $(MAINSRC:.c=$(OBJEXT))
SRCS = $(CSRCS) $(MAINSRC)
OBJS = $(COBJS) $(MAINOBJ)
TARGET = $(addprefix $(OBJ_DIR)/, $(patsubst ../%, sim/%, $(patsubst ./%, %, $(OBJS))))

# header dependency tracking (generated by -MMD)
-include $(TARGET:.o=.d)

all: default

$(OBJ_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@
	@echo "CC $<"

$(OBJ_DIR)/sim/%.o: ../%.c
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c $< -o $@
	@echo "CC $<"

default: $(TARGET)
	@mkdir -p $(BIN_DIR)
	$(CC) -o $(BIN_DIR)/$(BIN) $(TARGET) $(LDFLAGS)
	@echo ""
	@echo "Build done: $(BIN_DIR)/$(BIN)"
	@echo "Run: cd sim && ./build_sim/bin/pico_nav_sim"

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all clean