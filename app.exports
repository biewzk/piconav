/*
 * Symbol export whitelist for the demo host binary (linker version
 * script). Plugins dlopen()'ed from /data/apps resolve exactly these
 * symbols; everything else stays private to the executable. HAL is
 * deliberately NOT exported: it is the sim/device seam, plugins go
 * through the services (gps_service, config_api, status_bar, ...).
 * The map stack (map_view, Mapsforge) lives in the map plugin since
 * rootfs 1.9.15 and is no longer part of the host.
 */
{
  global:
    /* LVGL (compiled into the host; no liblvgl.a for plugins to link) */
    lv_*;
    /* app framework + services */
    app_*;
    msg_*;
    page_*;
    config_*;
    gps_service_*;
    trip_store_*;
    sampler_*;
    status_bar_*;
    log_*;
  local: *;
};
